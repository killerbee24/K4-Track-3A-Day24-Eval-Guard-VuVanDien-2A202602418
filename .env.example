# Required: use the exact API key and high-speed Claude model ID shown by MWAPI.
# Do not commit the real .env file.
LLM_API_KEY=
LLM_API_FORMAT=anthropic
LLM_BASE_URL=https://api.mwapi.dev
LLM_MODEL=
LLM_TIMEOUT=180

# Optional per-role overrides. Empty values inherit LLM_MODEL.
GENERATION_MODEL=
ENRICHMENT_MODEL=
EVALUATOR_MODEL=
JUDGE_MODEL=
GUARD_MODEL=
EVALUATOR_EMBEDDING_MODEL=BAAI/bge-m3

# Local cost circuit breaker for the MWAPI high-speed 5x tier.
# Base prices must match the selected model in the MWAPI dashboard.
LLM_PRICE_MULTIPLIER=5
LLM_BASE_INPUT_USD_PER_MTOK=1
LLM_BASE_OUTPUT_USD_PER_MTOK=5
LLM_MAX_RUN_USD=3
LLM_MAX_DAILY_USD=5
LLM_MAX_REQUESTS=600
LLM_MAX_OUTPUT_TOKENS=512

# M5 makes one paid call per chunk. Keep it disabled until the corpus size and
# estimated cost have been checked.
ENABLE_LLM_ENRICHMENT=0

# Optional: HuggingFace token for local model downloads.
HF_TOKEN=
